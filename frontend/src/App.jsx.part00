import { useState, useEffect, useRef } from 'react'
import * as THREE from 'three'
import './App.css'

const API = import.meta.env.VITE_API_URL || 'http://localhost:3001'

// ---- Shape textures (canvas) ----
function makeStarCanvas(size = 64) {
  const c = document.createElement('canvas')
  c.width = c.height = size
  const g = c.getContext('2d')
  const grd = g.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2)
  grd.addColorStop(0, 'rgba(255,255,255,1)')
  grd.addColorStop(0.2, 'rgba(255,240,220,0.9)')
  grd.addColorStop(0.5, 'rgba(200,180,255,0.35)')
  grd.addColorStop(1, 'rgba(0,0,0,0)')
  g.fillStyle = grd
  g.fillRect(0, 0, size, size)
  return c
}

function makeGlowCanvas(size = 128) {
  const c = document.createElement('canvas')
  c.width = c.height = size
  const g = c.getContext('2d')
  const grd = g.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2)
  grd.addColorStop(0, 'rgba(255,255,255,0.9)')
  grd.addColorStop(0.3, 'rgba(180,200,255,0.4)')
  grd.addColorStop(0.6, 'rgba(120,80,200,0.15)')
  grd.addColorStop(1, 'rgba(0,0,0,0)')
  g.fillStyle = grd
  g.fillRect(0, 0, size, size)
  return c
}

function makeNebulaCanvas(size = 256) {
  const c = document.createElement('canvas')
  c.width = c.height = size
  const g = c.getContext('2d')
  for (let i = 0; i < 40; i++) {
    const x = Math.random() * size
    const y = Math.random() * size
    const r = 20 + Math.random() * 60
    const grd = g.createRadialGradient(x, y, 0, x, y, r)
    const hue = 220 + Math.random() * 80
    grd.addColorStop(0, `hsla(${hue}, 70%, 60%, 0.15)`)
    grd.addColorStop(1, 'rgba(0,0,0,0)')
    g.fillStyle = grd
    g.fillRect(0, 0, size, size)
  }
  return c
}

// Stellar types for individualistic stars
const STELLAR_TYPES = [
  { name: 'pinpoint', size: [0.015, 0.04], color: [0.9, 0.95, 1], glow: 0.3 },
  { name: 'white-dwarf', size: [0.04, 0.08], color: [0.85, 0.9, 1], glow: 0.5 },
  { name: 'yellow-sun', size: [0.06, 0.12], color: [1, 0.95, 0.7], glow: 0.7 },
  { name: 'red-giant', size: [0.1, 0.2], color: [1, 0.4, 0.25], glow: 1.0 },
  { name: 'blue-giant', size: [0.08, 0.15], color: [0.5, 0.7, 1], glow: 0.9 },
  { name: 'jupiter', size: [0.07, 0.13], color: [0.85, 0.65, 0.4], glow: 0.2, bands: true },
  { name: 'neptune', size: [0.06, 0.11], color: [0.3, 0.5, 0.95], glow: 0.35 },
  { name: 'quasar', size: [0.05, 0.1], color: [0.7, 0.5, 1], glow: 1.4, jets: true },
]

export default function App() {
  const mountRef = useRef(null)
  const [query, setQuery] = useState('')
  const [response, setResponse] = useState('')
  const [responseKey, setResponseKey] = useState(0)
  const [status, setStatus] = useState('')
  const [needsMore, setNeedsMore] = useState(false)
  const [moreText, setMoreText] = useState('')
  const [morePrompt, setMorePrompt] = useState('')
  const [isTyping, setIsTyping] = useState(false)
  const [isActivating, setIsActivating] = useState(false)
  const [initialGlitch, setInitialGlitch] = useState(true)
  const [mode] = useState('combo') // always combo on load — no UI

  const typingRef = useRef(0)
  const typingTimeout = useRef(null)
  const starsRef = useRef([])
  const specialsRef = useRef([])
  const layersRef = useRef([])
  const gasRef = useRef([])
  const horizonRef = useRef(null)
  const photonRef = useRef(null)
  const auraRef = useRef(null)
  const sceneRef = useRef(null)
  const cameraRef = useRef(null)
  const rendererRef = useRef(null)
  const clockRef = useRef(null)
  const birthStarRef = useRef(null)
  const playPixelFormRef = useRef(null)
  const supernovaDoneRef = useRef(false)

  // ---- birth a unique star ----
  const birthStar = ({ x, y, z, hue }) => {
    const scene = sceneRef.current
    if (!scene) return
    const types = STELLAR_TYPES
    const t = types[Math.floor(Math.random() * types.length)]
    const size = t.size[0] + Math.random() * (t.size[1] - t.size[0])
    const color = new THREE.Color().setHSL(
      hue ?? Math.random(),
      0.55 + Math.random() * 0.35,
      0.55 + Math.random() * 0.3
    )
    // blend toward type color
    color.r = color.r * 0.4 + t.color[0] * 0.6
    color.g = color.g * 0.4 + t.color[1] * 0.6
    color.b = color.b * 0.4 + t.color[2] * 0.6

    const geo = new THREE.SphereGeometry(size, 16, 16)
    const mat = new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.95 })
    const mesh = new THREE.Mesh(geo, mat)
    mesh.position.set(x, y, z)
    scene.add(mesh)

    // glow sprite
    const glowTex = new THREE.CanvasTexture(makeGlowCanvas())
    const glowMat = new THREE.SpriteMaterial({
      map: glowTex,
      color,
      transparent: true,
      opacity: 0.55,
      